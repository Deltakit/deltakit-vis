{
  "name": "deltakit-visualise",
  "version": "0.6.0",
  "description": "Deltakit's visualisation renderer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Deltakit/deltakit-vis.git"
  },
  "main": "dist/deltakit-visualise.umd.js",
  "files": [
    "dist/deltakit-visualise.umd.js",
    "dist/deltakit-visualise.lite.umd.js"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm dev:full\" \"pnpm dev:lite -- --port 5174\"",
    "dev:full": "vite",
    "dev:lite": "vite --config vite.lite.config.ts",
    "build": "pnpm build:full && pnpm build:lite",
    "build:full": "tsc -p tsconfig.build.json && vite build",
    "build:lite": "tsc -p tsconfig.build.json && vite build --config vite.lite.config.ts",
    "dev-server": "python3 -m http.server 8000 --directory dist",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:geometry": "vitest run --config vitest.geometry.config.ts",
    "analyze": "pnpm analyze:full && pnpm analyze:lite",
    "analyze:full": "ANALYZE=true ANALYZE_OPEN_BROWSER=true pnpm build:full",
    "analyze:lite": "ANALYZE=true ANALYZE_OPEN_BROWSER=true pnpm build:lite"
  },
  "keywords": [],
  "author": {
    "name": "Deltakit Team",
    "email": "deltakit@riverlane.com"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.0.0",
    "jsdom": "^26.1.0",
    "rollup-plugin-visualizer": "^5.10.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.2.0",
    "vite": "^5.2.0",
    "vite-plugin-bundle-report": "^0.2.0",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@types/three": "^0.181.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.554.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "three": "^0.181.2",
    "tw-animate-css": "^1.2.9"
  }
}
